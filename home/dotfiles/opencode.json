{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "provider": {
    "google": {
      "models": {
        "gemini-2.5-pro": {},
        "gemini-2.5-flash": {}
      }
    },
    "anthropic": {
      "models": {
        "claude-opus-4-20250514": {},
        "claude-sonnet-4-20250514": {}
      }
    }
  },
  "mcp": {
    "effect-mcp": {
      "type": "local",
      "command": ["pnpx", "effect-mcp@latest"],
      "enabled": true
    },

    "linear-mcp": {
      "type": "remote",
      "url": "https://mcp.linear.app/sse",
      "enabled": true
    },

    "context7-mcp": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },

    "playwright-mcp": {
      "type": "local",
      "command": ["pnpx", "@playwright/mcp@latest"],
      "enabled": true
    },

    "google-devtools-mcp": {
      "type": "local",
      "command": ["pnpx", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
